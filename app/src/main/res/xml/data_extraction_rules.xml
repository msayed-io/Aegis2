<?xml version="1.0" encoding="utf-8"?>
<!-- Onyx (API 31+): exclude secrets from cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="onyx_accounts.xml" />
        <exclude domain="sharedpref" path="onyx_accounts_secure.xml" />
        <exclude domain="sharedpref" path="onyx_security.xml" />
        <exclude domain="sharedpref" path="onyx_vault.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="onyx_accounts.xml" />
        <exclude domain="sharedpref" path="onyx_accounts_secure.xml" />
        <exclude domain="sharedpref" path="onyx_security.xml" />
        <exclude domain="sharedpref" path="onyx_vault.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </device-transfer>
</data-extraction-rules>
